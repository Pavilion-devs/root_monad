{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable memory experimental request-auth",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "checkpointDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    }
  },
  "required": [
    "projectId",
    "serviceId",
    "checkpointDigest",
    "requestDigest",
    "nonce",
    "deadline"
  ],
  "additionalProperties": false
}
