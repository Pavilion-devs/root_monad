{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable memory local source",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "user_statement",
        "application_observation",
        "document"
      ]
    },
    "speaker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "locator": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "formatVersion",
    "projectId",
    "id",
    "kind",
    "speaker",
    "excerpt",
    "locator",
    "occurredAt"
  ],
  "additionalProperties": false
}
