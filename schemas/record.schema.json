{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portable memory local record",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "decision",
        "observation",
        "open_question"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "author": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-f]{64}$"
      },
      "maxItems": 100,
      "uniqueItems": true,
      "minItems": 1
    },
    "replaces": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "formatVersion",
    "projectId",
    "id",
    "kind",
    "content",
    "author",
    "sourceIds",
    "replaces"
  ],
  "additionalProperties": false
}
