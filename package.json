{
  "name": "portable-memory-authority-spike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts && node --test tests/wallet-onboarding.test.mjs && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "build:ui": "esbuild ui/app.ts --bundle --format=esm --target=es2022 --outfile=web/app.js",
    "demo": "npm run build:ui && tsx scripts/demo.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ajv": "8.20.0",
    "canonicalize": "2.1.0",
    "ethers": "6.17.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "esbuild": "0.28.2",
    "solc": "0.8.36",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
